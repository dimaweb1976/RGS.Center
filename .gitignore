# Результаты сборки
**/target/

# Архивы и исполняемые файлы
*.jar
*.zip

# Журналы
logs/
**/logs/
*.log

# Локальные файлы проекта и IDE
RGSCenter.ppr
**/nbproject/private/
/backup_camera*
.idea/
*.iml
.vscode/

# Системные файлы
.DS_Store
Thumbs.db

# Maven Wrapper JAR необходим для сборки
!.mvn/wrapper/maven-wrapper.jar
!**/.mvn/wrapper/maven-wrapper.jar

# Секреты и локальное окружение
.env
**/.env

# Генерируемые файлы frontend
/frontend/node_modules/
/frontend/.next/
/frontend/out/

# Временные и резервные каталоги
/tmp/
/backup_*/

# Восстановленные внутренние документы — не публиковать
/Docs/
/Diskusion/
/Wizard/
/tasks/
